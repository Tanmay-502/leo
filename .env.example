LEO_OLLAMA_MODEL=llama3.2
LEO_OLLAMA_URL=http://127.0.0.1:11434
LEO_DB_PATH=leo.db
LEO_MIC_INDEX=
LEO_WHISPER_MODEL=small
# offline uses pyttsx3 when installed; edge uses Edge TTS and needs internet
LEO_TTS_PROVIDER=offline
LEO_TTS_VOICE=en-US-AndrewNeural
LEO_TTS_RATE=+0%
LEO_HISTORY_LIMIT=12
LEO_TOOL_LOOP_LIMIT=4
LEO_GOOGLE_CREDENTIALS=credentials.json
LEO_GOOGLE_TOKEN=token.json
